{
  "name": "vs-marketplace",
  "version": "6.0.0",
  "packageManager": "npm@11.6.1",
  "description": "Visual Studio Marketplace Extension Publishing",
  "repository": {
    "type": "git",
    "url": "https://github.com/jessehouwing/vs-marketplace.git"
  },
  "keywords": [
    "visual-studio",
    "vs-marketplace",
    "visual-studio-extension",
    "vsix"
  ],
  "workspaces": [
    "packages/core",
    "packages/azdo-task",
    "packages/github-action"
  ],
  "scripts": {
    "initdev": "npm install --no-progress --force --no-update-notifier --legacy-peer-deps --no-fund",
    "download:vswhere": "node Scripts/download-vswhere.mjs",
    "build": "npm run download:vswhere && npm run build --workspaces --if-present",
    "build:clean": "npm run clean && npm run initdev && npm run build",
    "package:tasks": "tfx extension create --root . --output-path dist --manifest-globs vss-extension.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --no-coverage",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:action-inputs": "node Scripts/validate-action-inputs.mjs",
    "validate:action-inputs:check": "node Scripts/validate-action-inputs.mjs --check",
    "docs:validate-samples": "node Scripts/validate-doc-yaml-samples.mjs",
    "bundle:azdo": "node Scripts/bundle.mjs azdo",
    "bundle:actions": "node Scripts/bundle.mjs actions",
    "bundle": "npm run bundle:azdo && npm run bundle:actions",
    "bundle:frozen": "node Scripts/bundle.mjs all --frozen",
    "update-version": "node Scripts/update-version.mjs",
    "clean": "git clean -fdX"
  },
  "author": "Jesse Houwing",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "tfx-cli": "^0.24.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.0",
    "@rollup/rollup-win32-x64-gnu": "^4.61.0",
    "@rollup/rollup-win32-x64-msvc": "^4.62.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@azure/msal-node": {
      "uuid": "^11.1.1"
    },
    "@humanfs/node": "^0.16.8",
    "azure-pipelines-tool-lib": {
      "uuid": "^11.1.1"
    },
    "baseline-browser-mapping": "^2.11.21",
    "browserslist": "^4.28.9",
    "qs": "^6.16.0",
    "undici": "^6.28.1",
    "uuid": "^11.1.1"
  }
}
